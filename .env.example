# Copia este archivo como .env. No pegues valores secretos en el chat.
# sqlite conserva la versión local. postgres requiere configurar Supabase.
DB_DRIVER=sqlite
DATABASE_URL=
# Certificado raíz descargado del panel Supabase (ruta local).
PG_CA_FILE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=icasys-evidencias
PORT=4173
HOST=127.0.0.1
# Para publicar: URL HTTPS exacta, HOST=0.0.0.0 y COOKIE_SECURE=1.
APP_ORIGIN=http://127.0.0.1:4173
COOKIE_SECURE=0
