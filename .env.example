# Copia este archivo como .env. No pegues valores secretos en el chat.
# sqlite conserva la versión local. postgres requiere configurar Supabase.
DB_DRIVER=sqlite
DATABASE_URL=
# Certificado raíz descargado del panel Supabase (ruta local).
PG_CA_FILE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=icasys-evidencias
PORT=4173
HOST=127.0.0.1
# Para publicar: URL HTTPS exacta, HOST=0.0.0.0 y COOKIE_SECURE=1.
APP_ORIGIN=http://127.0.0.1:4173
COOKIE_SECURE=0
# Solo habilitar después de aplicar supabase/03-password-recovery.sql,
# verificar el remitente Brevo y usar APP_ORIGIN HTTPS.
MAIL_RECOVERY_ENABLED=0
MAIL_FROM_EMAIL=
BREVO_API_KEY=
# Alternativa elegida: Supabase Auth. Activar después de la migración 04
# y de configurar Site URL. Usa la plantilla predeterminada de Supabase; mantener Brevo desactivado.
SUPABASE_AUTH_ENABLED=0
